# Google Cloud Speech-to-Text V2
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_SPEECH_REGION=asia-southeast1
GOOGLE_SPEECH_MODEL=chirp_2
# Set GOOGLE_APPLICATION_CREDENTIALS in your shell to the local service-account JSON file path.

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# 10 MB; suitable for the MVP's short recordings.
MAX_AUDIO_BYTES=10485760
